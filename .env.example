# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEMO DEFAULTS — NOT PRODUCTION SECRETS.
# Copy to `.env` and adjust. Every value below has an equally obvious default
# in docker-compose.yml; nothing here is required for `docker compose up`.
# ─────────────────────────────────────────────────────────────────────────────

# Host ports
KEYCLOAK_PORT=8080
AIRFLOW_PORT=8082
MCP_PORT=8081

# Keycloak realm (must match keycloak/realm-export.json and
# the `included.custom.audience` mapper in it: http://localhost:8081/mcp)
KEYCLOAK_REALM=airflow-demo

# Keycloak admin console (http://localhost:8080) — demo only
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-demo

# Airflow 3 REST API v2 service identities used by the MCP server.
# Wired into Airflow via AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS + entrypoint.sh.
AIRFLOW_READER_USERNAME=mcp-reader
AIRFLOW_READER_PASSWORD=reader-demo
AIRFLOW_WRITER_USERNAME=mcp-writer
AIRFLOW_WRITER_PASSWORD=writer-demo

# Keycloak end users (BUILT INTO keycloak/realm-export.json — changing them
# requires editing the realm export and wiping the keycloak-data volume):
#   alice / alice-demo  -> group airflow-viewer   (read-only MCP tools)
#   bob   / bob-demo    -> group airflow-operator (read + trigger_dag_run)